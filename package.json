{
  "name": "tickory",
  "version": "0.3.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Tickory: zelf te hosten takenapp met gedeelde projecten (sync-server en web-app, zero dependencies, Node 26)",
  "type": "module",
  "engines": { "node": ">=26" },
  "scripts": {
    "test": "node --test shared/ server/ client/core/",
    "start": "node server/main.ts",
    "e2e": "node scripts/e2e.ts",
    "backup": "node server/backup.ts",
    "site:build": "node scripts/build-site.ts",
    "site:check": "node scripts/build-site.ts && node scripts/site-check.ts",
    "site:serve": "node scripts/serve-site.ts",
    "site:shots": "node scripts/site-shots.ts"
  }
}
