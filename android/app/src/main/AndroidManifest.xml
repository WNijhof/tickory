<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- De server bereiken (de web-app in de WebView en het verversen van herinneringen op de achtergrond). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Herinneringen als melding tonen. Op Android 13 en nieuwer vraagt de app hier eerst toestemming voor. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Na het opstarten van het toestel de alarmen opnieuw zetten; Android wist ze bij uitschakelen. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Een herinnering op de minuut laten afgaan. Android 13 en nieuwer: USE_EXACT_ALARM, bedoeld voor apps waarvan
      herinneren de kern is; de gebruiker hoeft niets aan te zetten. Android 12 en 12L: SCHEDULE_EXACT_ALARM, daar
      standaard toegekend en door de gebruiker uit te zetten. Ouder: geen recht nodig.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!--
      Android 17 en nieuwer: zonder dit recht (dat de gebruiker moet toestaan, onder "Apparaten in de buurt") kan een
      app geen adressen op het eigen netwerk bereiken, dus ook geen server thuis op http://192.168.x.x. De app vraagt
      het alleen als het ingestelde serveradres op het eigen netwerk ligt. Oudere versies kennen dit recht niet en
      slaan het over.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- WorkManager brengt dit recht mee voor langlopend werk op de voorgrond. Dat gebruikt deze app niet. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <application
        android:name=".TickoryApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tickory"
        android:usesCleartextTraffic="true"
        tools:targetApi="33">

        <!-- De WebView stuurt geen gebruiksstatistieken of crashrapporten naar Google. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <!-- Geen "Safe Browsing": daarbij worden (delen van) bezochte adressen bij Google nagekeken. De app opent alleen de eigen server. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <!--
          Eén scherm, één exemplaar (singleTask): tikken op een melding opent de taak in de app die al open staat.
          Draaien en formaatwijzigingen handelt het scherm zelf af, zodat de web-app daarbij niet opnieuw laadt.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Delen naar Tickory": tekst of een link uit een andere app wordt een voorgevuld venster "Taak toevoegen". -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SetupActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- Alle drie alleen voor de app zelf en voor Android (exported="false"): andere apps kunnen ze niet aanroepen. -->
        <receiver
            android:name=".reminders.AlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.ActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.SystemEventsReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          De widgets. De ontvangers zijn niet exporteerbaar: alleen Android (de widget-host) stuurt ze iets. Het
          configuratiescherm moet wel bereikbaar zijn voor Android (exported) en controleert het widget-id zelf.
        -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:exported="false"
            android:label="@string/widget_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver
            android:name=".widget.UpcomingWidgetProvider"
            android:exported="false"
            android:label="@string/widget_upcoming_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_upcoming_info" />
        </receiver>
        <receiver
            android:name=".widget.ProjectWidgetProvider"
            android:exported="false"
            android:label="@string/widget_project_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_project_info" />
        </receiver>
        <receiver
            android:name=".widget.AddWidgetProvider"
            android:exported="false"
            android:label="@string/widget_add_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_add_info" />
        </receiver>
        <receiver
            android:name=".widget.WidgetTickReceiver"
            android:exported="false" />

        <!-- De tegel "Taak toevoegen" in de snelle instellingen. Alleen het systeem (BIND_QUICK_SETTINGS_TILE) mag hem binden. -->
        <service
            android:name=".AddTaskTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_add"
            android:label="@string/tile_add_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".widget.WidgetListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Heeft geen scherm: voert een tik op een regel van een widget uit (afvinken, taak openen) en sluit. -->
        <activity
            android:name=".widget.WidgetActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_project_name"
            android:theme="@style/Theme.Tickory">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
