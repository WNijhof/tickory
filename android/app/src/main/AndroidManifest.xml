<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- De server bereiken (de web-app in de WebView en het verversen van herinneringen op de achtergrond). -->
    <!-- Om te kunnen zien of het toestel een spraakherkenner heeft (spraakinvoer in Taak toevoegen). -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- Om te kunnen zien of het toestel een camera-app heeft (een foto maken als bijlage). Tickory vraagt zelf geen cameratoestemming. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Herinneringen als melding tonen. Op Android 13 en nieuwer vraagt de app hier eerst toestemming voor. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Na het opstarten van het toestel de alarmen opnieuw zetten; Android wist ze bij uitschakelen. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Een herinnering op de minuut laten afgaan. Android 13 en nieuwer: USE_EXACT_ALARM, bedoeld voor apps waarvan
      herinneren de kern is; de gebruiker hoeft niets aan te zetten. Android 12 en 12L: SCHEDULE_EXACT_ALARM, daar
      standaard toegekend en door de gebruiker uit te zetten. Ouder: geen recht nodig.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!--
      Android 17 en nieuwer: zonder dit recht (dat de gebruiker moet toestaan, onder "Apparaten in de buurt") kan een
      app geen adressen op het eigen netwerk bereiken, dus ook geen server thuis op http://192.168.x.x. De app vraagt
      het alleen als het ingestelde serveradres op het eigen netwerk ligt. Oudere versies kennen dit recht niet en
      slaan het over.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!--
      Herinneringen op een plek ("herinner me als ik bij Thuis aankom"). De positie wordt alleen op het toestel met de
      plaatsen vergeleken en gaat nooit naar de server. De app vraagt dit pas als de gebruiker zelf een herinnering op een
      plek maakt of de locatiecontrole aanzet, met uitleg vooraf. Nauwkeurige locatie is nodig (een straal van enkele
      honderden meters is met een grove locatie niet te volgen); "altijd toestaan" laat het ook werken als de app dicht is.
      Geen Google-diensten: de gewone locatiedienst van Android.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!--
      Geluid opnemen bij een notitie. De app vraagt het pas als de gebruiker zelf op "Geluid opnemen" tikt; de opname gaat
      alleen naar de eigen server, als bestand bij die notitie. Toestellen zonder microfoon kunnen de app gewoon installeren.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Ook toestellen zonder GPS mogen de app installeren; dan werkt alleen een grove positie via netwerken. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <!-- WorkManager brengt dit recht mee voor langlopend werk op de voorgrond. Dat gebruikt deze app niet. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <application
        android:name=".TickoryApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tickory"
        android:usesCleartextTraffic="true"
        tools:targetApi="33">

        <!-- De WebView stuurt geen gebruiksstatistieken of crashrapporten naar Google. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <!-- Geen "Safe Browsing": daarbij worden (delen van) bezochte adressen bij Google nagekeken. De app opent alleen de eigen server. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <!--
          Eén scherm, één exemplaar (singleTask): tikken op een melding opent de taak in de app die al open staat.
          Draaien en formaatwijzigingen handelt het scherm zelf af, zodat de web-app daarbij niet opnieuw laadt.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Terug van de inlogdienst (SSO): de browser opent tickory://oidc?code=… na het inloggen. De code werkt alleen met een
              geheim dat de web-app in deze app heeft (zie core/SignInLink.kt); een andere app die dit schema ook claimt, heeft er niets aan.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oidc"
                    android:scheme="tickory" />
            </intent-filter>
            <!-- "Delen naar Tickory": tekst of een link uit een andere app wordt een voorgevuld venster "Taak toevoegen". -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Bestanden (foto's, pdf's, ...) uit een andere app worden bijlagen van een nieuwe taak, na bevestiging in Taak toevoegen. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          Geeft een bestand uit de cache van de app aan een andere app (een bijlage openen) en laat de camera in een eigen bestand
          schrijven. Alleen de mappen in file_paths.xml, niet exporteerbaar: een bestand is alleen leesbaar voor wie er een
          tijdelijk recht op krijgt.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".SetupActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- Alle drie alleen voor de app zelf en voor Android (exported="false"): andere apps kunnen ze niet aanroepen. -->
        <receiver
            android:name=".reminders.AlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.ActionReceiver"
            android:exported="false" />
        <!-- Plaatsbepalingen van Android voor de locatiecontrole; alleen voor de app zelf. -->
        <receiver
            android:name=".geo.GeoReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.SystemEventsReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          De widgets. De ontvangers zijn niet exporteerbaar: alleen Android (de widget-host) stuurt ze iets. Het
          configuratiescherm moet wel bereikbaar zijn voor Android (exported) en controleert het widget-id zelf.
        -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:exported="false"
            android:label="@string/widget_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver
            android:name=".widget.UpcomingWidgetProvider"
            android:exported="false"
            android:label="@string/widget_upcoming_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_upcoming_info" />
        </receiver>
        <receiver
            android:name=".widget.ProjectWidgetProvider"
            android:exported="false"
            android:label="@string/widget_project_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_project_info" />
        </receiver>
        <receiver
            android:name=".widget.AddWidgetProvider"
            android:exported="false"
            android:label="@string/widget_add_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_add_info" />
        </receiver>
        <receiver
            android:name=".widget.QuickActionsWidgetProvider"
            android:exported="false"
            android:label="@string/widget_quick_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_actions_info" />
        </receiver>
        <receiver
            android:name=".widget.ProductivityWidgetProvider"
            android:exported="false"
            android:label="@string/widget_prod_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_productivity_info" />
        </receiver>
        <receiver
            android:name=".widget.AddNoteWidgetProvider"
            android:exported="false"
            android:label="@string/widget_addnote_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_add_note_info" />
        </receiver>
        <receiver
            android:name=".widget.WidgetTickReceiver"
            android:exported="false" />

        <!-- Het ochtendoverzicht en de avondreview: het alarm van elke dag. -->
        <receiver
            android:name=".reminders.OverviewReceiver"
            android:exported="false" />

        <!-- De tegel "Taak toevoegen" in de snelle instellingen. Alleen het systeem (BIND_QUICK_SETTINGS_TILE) mag hem binden. -->
        <service
            android:name=".AddTaskTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_add"
            android:label="@string/tile_add_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- De tegel "Notitie toevoegen" in de snelle instellingen. Alleen het systeem (BIND_QUICK_SETTINGS_TILE) mag hem binden. -->
        <service
            android:name=".AddNoteTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_note"
            android:label="@string/tile_note_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".widget.WidgetListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- De widget Notities (widget/NotesWidget.kt): de kaartjes komen uit NotesWidgetService, alleen door Android te binden. -->
        <receiver
            android:name=".widget.NotesWidgetProvider"
            android:exported="false"
            android:label="@string/widget_notes_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_notes_info" />
        </receiver>
        <service
            android:name=".widget.NotesWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Heeft geen scherm: voert een tik op een regel van een widget uit (afvinken, taak openen) en sluit. -->
        <activity
            android:name=".widget.WidgetActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
          Het kleine venster "Taak toevoegen" over het startscherm (de "+" van een widget, de knop-widget en de tegel). Alleen de app
          zelf kan het openen (exported="false", via haar eigen onveranderlijke intenties); een eigen taak (taskAffinity leeg), niet in
          de lijst met recente apps, zodat het boven het startscherm verschijnt en niet de volledige app naar voren haalt.
        -->
        <activity
            android:name=".quickadd.QuickAddActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/quick_title"
            android:taskAffinity=""
            android:theme="@style/Theme.Tickory.QuickAdd"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <!-- Het kleine venster "Notitie toevoegen" over het startscherm, op dezelfde manier als "Taak toevoegen" hierboven. -->
        <activity
            android:name=".quicknote.QuickNoteActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/quick_note_title"
            android:taskAffinity=""
            android:theme="@style/Theme.Tickory.QuickAdd"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <!--
          Het kleine venster van een taak over het startscherm (een tik op een taak in een widget): zoals "Taak toevoegen" een eigen taak
          (taskAffinity leeg), niet in de lijst met recente apps en alleen door de app zelf te openen.
        -->
        <activity
            android:name=".widget.TaskPopupActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/popup_title"
            android:taskAffinity=""
            android:theme="@style/Theme.Tickory.QuickAdd"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_project_name"
            android:theme="@style/Theme.Tickory">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- Herplannen vanuit een widget: een klein venster over het startscherm, alleen door de app zelf te openen. -->
        <activity
            android:name=".widget.RescheduleActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/reschedule_title"
            android:taskAffinity=""
            android:theme="@style/Theme.Tickory.QuickAdd" />

        <activity
            android:name=".widget.WidgetStyleActivity"
            android:exported="true"
            android:label="@string/widget_settings_title"
            android:theme="@style/Theme.Tickory">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
