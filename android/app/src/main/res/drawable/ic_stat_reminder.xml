<?xml version="1.0" encoding="utf-8"?>
<!--
  Het pictogram van een melding in de statusbalk: een vinkje, hetzelfde als in client/icon.svg maar groter in beeld.
  Android toont hiervan alleen de vorm (wit, of in de accentkleur), dus alleen de omtrek telt.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="1.7"
        android:scaleY="1.7">
        <path
            android:fillColor="#00000000"
            android:pathData="M148,268l72,72 144,-168"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="40" />
    </group>
</vector>
