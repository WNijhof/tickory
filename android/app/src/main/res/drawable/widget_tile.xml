<?xml version="1.0" encoding="utf-8"?>
<!-- Een knop van de widget Snelle acties: een afgerond vlak met een dunne rand in de accentkleur. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/widget_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
