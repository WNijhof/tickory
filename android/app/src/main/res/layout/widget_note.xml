<?xml version="1.0" encoding="utf-8"?>
<!-- Een notitie in de notitiewidget: een afgerond kaartje in de kleur van de notitie, met de kop, een paar regels tekst en de stand van de checklist. -->
<!-- De buitenste laag geeft de ruimte tussen de kaartjes: in een widgetlijst werken marges op de regel zelf niet. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    tools:ignore="UselessParent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingTop="4dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/note_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_note_card"
        android:minHeight="@dimen/widget_row_min"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <!-- titel en punaise apart: de punaise wordt per notitie aan- of uitgezet (dat kan niet met een samengestelde afbeelding) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <TextView
                android:id="@+id/note_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/widget_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/note_pin"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_pin"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/note_excerpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:lineSpacingExtra="1dp"
            android:maxLines="3"
            android:textColor="@color/widget_text_soft"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/note_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textColor="@color/widget_text_soft"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
