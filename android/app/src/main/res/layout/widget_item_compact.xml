<?xml version="1.0" encoding="utf-8"?>
<!--
  Een taak in een lijstwidget in de compacte weergave (zoals in de widget van Todoist): één regel, links de cirkel om af te vinken, dan
  de titel, en rechts, uitgelijnd aan de rand, de datum. Geen tweede regel en geen project. Dezelfde id's als widget_item.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/widget_row_compact"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    tools:ignore="RtlSymmetry">

    <ImageView
        android:id="@+id/check"
        android:layout_width="@dimen/widget_row_compact"
        android:layout_height="@dimen/widget_row_compact"
        android:background="@drawable/widget_ripple"
        android:importantForAccessibility="yes"
        android:scaleType="center"
        android:src="@drawable/widget_check_p4"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/text_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/widget_ripple"
        android:gravity="center_vertical"
        android:minHeight="@dimen/widget_row_compact"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/item_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:textColor="@color/widget_text_soft"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
