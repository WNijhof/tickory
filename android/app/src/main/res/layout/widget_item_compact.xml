<?xml version="1.0" encoding="utf-8"?>
<!--
  Een taak in de compacte weergave, zoals in Todoist: geen cirkel, de titel, rechts de datum met
  het herhalings-pictogram en de vlag van de prioriteit (niet bij prioriteit 4). De hele rij opent de taak.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/widget_row_compact"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    tools:ignore="RtlSymmetry">

    <LinearLayout
        android:id="@+id/text_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/widget_ripple"
        android:gravity="center_vertical"
        android:minHeight="@dimen/widget_row_compact"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/item_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_text_soft"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/icon_recurring"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="3dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_attr_recurring" />

        <ImageView
            android:id="@+id/icon_priority"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_flag" />
    </LinearLayout>
</LinearLayout>
