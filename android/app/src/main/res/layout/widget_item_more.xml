<?xml version="1.0" encoding="utf-8"?>
<!-- De laatste rij van een lange lijst: tik om de app te openen voor meer taken. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/more_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_ripple"
    android:gravity="center_vertical"
    android:minHeight="@dimen/widget_row_min"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/more_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_more" />

    <TextView
        android:id="@+id/more_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_text_soft"
        android:textSize="13sp" />
</LinearLayout>
