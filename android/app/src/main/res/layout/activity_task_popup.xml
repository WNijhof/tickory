<?xml version="1.0" encoding="utf-8"?>
<!--
  Het venster van een taak (TaskPopupActivity), over het startscherm: een tik op een taak in een widget. Zoals bij Todoist: bovenaan het
  project (tik = verplaatsen), dan de titel en de beschrijving om meteen te bewerken, en de datum, de prioriteit en de labels als regels.
  Ernaast tikken of terug sluit het en slaat op (de lege ruimte is popup_root); het vlak onderaan (popup_sheet) vangt zijn eigen tikken.
  Alle tikvlakken zijn minstens 48 dp hoog.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/popup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    tools:ignore="MergeRootFrame">

    <LinearLayout
        android:id="@+id/popup_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:accessibilityPaneTitle="@string/popup_title"
        android:background="@drawable/quick_sheet"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        tools:ignore="UselessParent"
        tools:targetApi="28">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"
            android:background="@drawable/quick_handle"
            android:importantForAccessibility="no" />

        <!-- bovenaan: het project (tik om te verplaatsen) en "Openen in de app" (voor subtaken en opmerkingen) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/popup_project"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:minHeight="48dp"
                android:paddingStart="0dp"
                android:paddingEnd="8dp"
                android:textAllCaps="false"
                android:textColor="@color/text_soft"
                android:textSize="14sp" />

            <Button
                android:id="@+id/popup_open_app"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/quick_open_app"
                android:textAllCaps="false"
                android:textColor="@color/brand"
                android:textSize="14sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/popup_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/popup_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="@string/popup_content_hint"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textAutoCorrect|textMultiLine"
                    android:maxLength="4000"
                    android:minHeight="48dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_soft"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/popup_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="top|start"
                    android:hint="@string/popup_description_hint"
                    android:imeOptions="flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textAutoCorrect|textMultiLine"
                    android:maxLength="16000"
                    android:maxLines="8"
                    android:minHeight="48dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_soft"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/quick_stroke"
                    android:importantForAccessibility="no" />

                <!-- de regels Datum, Prioriteit en Labels (item_reschedule_choice), gevuld door het venster -->
                <LinearLayout
                    android:id="@+id/popup_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/popup_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:paddingTop="8dp"
                    android:textColor="@color/danger"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/popup_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingEnd="8dp"
                android:textColor="@color/text_soft"
                android:textSize="13sp" />

            <Button
                android:id="@+id/popup_complete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_primary"
                android:minWidth="96dp"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/popup_complete"
                android:textAllCaps="false"
                android:textColor="@color/on_brand"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
