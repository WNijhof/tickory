<?xml version="1.0" encoding="utf-8"?>
<!-- De instellingen van Productiviteit en Snelle acties: thema, weergave, ondoorzichtigheid en (Productiviteit) wat een tik doet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/style_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:padding="16dp"
        android:text="@string/widget_settings_title"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                style="@style/WidgetConfigSection"
                android:accessibilityHeading="true"
                android:text="@string/widget_accent" />

            <Spinner
                android:id="@+id/style_accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/widget_accent"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                style="@style/WidgetConfigSection"
                android:accessibilityHeading="true"
                android:text="@string/widget_theme" />

            <RadioGroup
                android:id="@+id/style_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <RadioButton
                    android:id="@+id/style_theme_system"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/widget_theme_system" />

                <RadioButton
                    android:id="@+id/style_theme_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/widget_theme_light" />

                <RadioButton
                    android:id="@+id/style_theme_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/widget_theme_dark" />
            </RadioGroup>

            <TextView
                style="@style/WidgetConfigSection"
                android:accessibilityHeading="true"
                android:text="@string/widget_opacity" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <SeekBar
                    android:id="@+id/style_opacity"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/widget_opacity"
                    android:max="100" />

                <TextView
                    android:id="@+id/style_opacity_value"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/text"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/style_tap_label"
                style="@style/WidgetConfigSection"
                android:accessibilityHeading="true"
                android:text="@string/widget_tap_action" />

            <Spinner
                android:id="@+id/style_tap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/widget_tap_action"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/style_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/button_primary"
        android:minHeight="48dp"
        android:text="@string/widget_settings_save"
        android:textAllCaps="false"
        android:textColor="@color/on_brand"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
