<?xml version="1.0" encoding="utf-8"?>
<!--
  Herplannen (RescheduleActivity): de knop naast "Over tijd" in een lijstwidget opent dit venster over het startscherm, zoals in Todoist
  (SchedulerDialogActivity met de te late taken). Snelle keuzes met de weekdag rechts, en "Datum kiezen…". Ernaast tikken sluit het.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reschedule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    tools:ignore="MergeRootFrame">

    <LinearLayout
        android:id="@+id/reschedule_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:accessibilityPaneTitle="@string/reschedule_title"
        android:background="@drawable/quick_sheet"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp"
        tools:ignore="UselessParent"
        tools:targetApi="28">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/quick_handle"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/reschedule_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:text="@string/reschedule_title"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reschedule_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text_soft"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/reschedule_choices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
