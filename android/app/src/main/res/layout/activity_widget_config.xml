<?xml version="1.0" encoding="utf-8"?>
<!-- De instellingen van een lijstwidget: thema, compacte weergave, doorzichtigheid en (alleen Project of lijst) wat hij toont. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/config_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:padding="16dp"
        android:text="@string/widget_settings_title"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/config_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/config_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/button_primary"
        android:minHeight="48dp"
        android:text="@string/widget_settings_save"
        android:textAllCaps="false"
        android:textColor="@color/on_brand"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
