<?xml version="1.0" encoding="utf-8"?>
<!-- Het scherm waarop je kiest wat een widget toont (project, Inbox, Vandaag, Binnenkort). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/config_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:padding="16dp"
        android:text="@string/widget_config_title"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/config_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/widget_config_hint_signed_out"
        android:textColor="@color/text_soft"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/config_open_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:minHeight="48dp"
        android:text="@string/widget_config_open_app"
        android:visibility="gone" />

    <ListView
        android:id="@+id/config_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
