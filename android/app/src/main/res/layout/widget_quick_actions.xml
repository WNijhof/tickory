<?xml version="1.0" encoding="utf-8"?>
<!-- Snelle acties: twee rijen van twee knoppen. Elke knop is een vlak met een pictogram; de naam staat in de beschrijving voor TalkBack. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- De achtergrond als eigen laag: kleur (thema) en doorzichtigheid zijn per widget in te stellen. -->
    <ImageView
        android:id="@+id/quick_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/quick_today"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_ripple"
            android:contentDescription="@string/widget_quick_today">

            <ImageView
                android:id="@+id/quick_today_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_tile_bg" />

            <ImageView
                android:id="@+id/quick_today_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_shortcut_today" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/quick_inbox"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_ripple"
            android:contentDescription="@string/widget_quick_inbox">

            <ImageView
                android:id="@+id/quick_inbox_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_tile_bg" />

            <ImageView
                android:id="@+id/quick_inbox_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_inbox" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/quick_note"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_ripple"
            android:contentDescription="@string/widget_quick_note">

            <ImageView
                android:id="@+id/quick_note_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_tile_bg" />

            <ImageView
                android:id="@+id/quick_note_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_shortcut_note" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/quick_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_ripple"
            android:contentDescription="@string/widget_add_task">

            <ImageView
                android:id="@+id/quick_add_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_tile_bg" />

            <ImageView
                android:id="@+id/quick_add_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_add" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
