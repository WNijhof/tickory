<?xml version="1.0" encoding="utf-8"?>
<!-- Snelle acties: vier knoppen (Vandaag, Inbox, Taak toevoegen, Nieuwe notitie), 2x2 vakjes, niet te vergroten. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="io.github.wnijhof.tickory.widget.WidgetStyleActivity"
    android:description="@string/widget_quick_description"
    android:initialLayout="@layout/widget_quick_actions"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:resizeMode="none"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:widgetFeatures="reconfigurable"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
