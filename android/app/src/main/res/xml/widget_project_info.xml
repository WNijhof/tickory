<?xml version="1.0" encoding="utf-8"?>
<!--
  De widget Project of lijst. Bij het plaatsen opent WidgetConfigActivity; met "reconfigurable" kan de keuze later
  opnieuw (Android 9 en nieuwer, vasthouden op de widget). Oudere versies negeren dat.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="io.github.wnijhof.tickory.widget.WidgetConfigActivity"
    android:description="@string/widget_project_description"
    android:initialLayout="@layout/widget_list"
    android:maxResizeWidth="450dp"
    android:maxResizeHeight="600dp"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_preview_list"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
