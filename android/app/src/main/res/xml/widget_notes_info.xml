<?xml version="1.0" encoding="utf-8"?>
<!--
  De widget Notities: je notities als kaartjes, vastgepinde eerst. Formaat zoals de lijstwidgets: minstens 2x2 vakjes, tot
  ongeveer 5 breed en 6 hoog. updatePeriodMillis tekent alleen opnieuw uit de gegevens op het toestel (geen verbinding).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_notes_description"
    android:initialLayout="@layout/widget_list"
    android:maxResizeWidth="450dp"
    android:maxResizeHeight="600dp"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_preview_notes"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
