    <color name="brand">#0F766E</color>
    <color name="on_brand">#FFFFFF</color>
    <color name="background">#FFFFFF</color>
    <color name="text">#1C1F23</color>
    <color name="text_soft">#5F6B76</color>
    <color name="danger">#B42318</color>
    <color name="warn">#B54708</color>

    <!-- Het kleine venster "Taak toevoegen": het vlak, de randen en de vulling van de knoppen en labels. -->
    <color name="quick_surface">#FFFFFF</color>
    <color name="quick_stroke">#C4CCD4</color>
    <color name="quick_chip">#EEF2F5</color>
    <!-- Herkende tekst in het veld (datum, #project, @label …), gemarkeerd zoals bij Todoist. -->
    <color name="quick_recognized">#D5EEEA</color>
    <color name="quick_recognized_text">#0F766E</color>
    <color name="quick_chip_on">#D5EEEA</color>

    <!-- Accentkleur van het pictogram in een melding; in licht en donker gelijk. -->
    <color name="notification_accent">#0F766E</color>
