# Kopieer dit bestand naar ".env" en vul een geheim token in (minimaal 24 tekens).
# Genereer er een met:   openssl rand -base64 32   (of: docker run --rm node:26-alpine node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
# Het token geeft toegang tot al je taken: deel het niet, en zet ".env" nooit in git.
TODO_TOKEN=
