# Kopieer dit bestand naar ".env" en vul de gegevens voor het eerste account in.
# Dat account wordt bij de allereerste start aangemaakt en is beheerder: daarmee maak je in de app de andere accounts aan.
# Het wachtwoord heeft minimaal 10 tekens en mag niet makkelijk te raden zijn (geen veelgebruikt woord of wachtwoord).
# Na de eerste start haal je het hier weg én maak je de container opnieuw aan (docker compose up -d --force-recreate):
# anders blijft het in de configuratie van de container staan, waar "docker inspect" het toont. Zet ".env" nooit in git.
TODO_ADMIN_USER=
TODO_ADMIN_PASSWORD=
# Of, zonder het wachtwoord in de omgeving: het pad (in de container) van een bestand met het wachtwoord, zoals een Docker-secret.
TODO_ADMIN_PASSWORD_FILE=
# De naam zoals anderen die zien (optioneel; anders de gebruikersnaam):
TODO_ADMIN_NAME=
# Staat er een eigen reverse proxy voor (Caddy, nginx, Traefik)? Zet dit dan op 1.
# Staan er meer proxy's achter elkaar (bijvoorbeeld een CDN en nginx)? Zet dan het aantal, bijvoorbeeld 2.
TRUST_PROXY=0
# Meldingen in de browser (herinneringen): jouw contactadres als beheerder, voor de pushdienst van de browser,
# bijvoorbeeld mailto:jij@voorbeeld.nl of een https-adres. Leeg laten mag: dan gaat er geen contactadres mee.
# De pushdienst van Apple (Safari, iPhone, iPad) vraagt er wel om.
VAPID_SUBJECT=
# De tijdzone voor gebruikers die er zelf nog geen hebben ingesteld (de app stelt hem normaal vanzelf in).
DEFAULT_TIMEZONE=Europe/Amsterdam
# Extra pushdiensten die mogen (komma-gescheiden domeinen), bijvoorbeeld een eigen dienst. Leeg = alleen de gewone van de browsers.
PUSH_ALLOWED_HOSTS=
# Bijlagen bij taken. De bestanden staan in het volume, in /data/attachments naast de database; zet ze mee in je back-up (zie het README).
# Het grootste bestand en de opslagruimte per gebruiker, in megabytes. Staat er een reverse proxy voor, zet daar de grens dan minstens
# even hoog (nginx: client_max_body_size 30m; de standaard van nginx is 1 MB en geeft dan "413").
MAX_UPLOAD_MB=25
ATTACHMENT_QUOTA_MB=1024
# Aangemelde apparaten: na hoeveel dagen zonder gebruik een apparaat vanzelf wordt afgemeld (standaard 90), en na hoeveel dagen
# elk apparaat hoe dan ook opnieuw moet inloggen (standaard 365). 0 zet de grens uit.
SESSION_IDLE_DAYS=90
SESSION_MAX_DAYS=365
# Het adres waarop Tickory te bereiken is, zonder / aan het eind (nodig voor inloggen met SSO hieronder).
PUBLIC_URL=
# Inloggen met SSO (OpenID Connect): Authentik, Authelia, Keycloak, Pocket ID, Zitadel, Google, Microsoft. Leeg = uit.
# Maak bij de provider een client met als redirect-URI <PUBLIC_URL>/api/v1/auth/oidc/callback. Zie het README ("Inloggen met SSO").
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Het clientgeheim (leeg bij een publieke client met alleen PKCE), of het pad van een bestand ermee (bijvoorbeeld een Docker-secret).
OIDC_CLIENT_SECRET=
OIDC_CLIENT_SECRET_FILE=
# Alleen nodig als de redirect-URI niet <PUBLIC_URL>/api/v1/auth/oidc/callback is.
OIDC_REDIRECT_URL=
# Standaard "openid profile email"; voeg "groups" toe voor groepen.
OIDC_SCOPES=
# De naam op de knop: "Inloggen met …".
OIDC_BUTTON_NAME=
# 1 = een onbekende identiteit krijgt bij de eerste keer inloggen een nieuw account (zonder wachtwoord). Standaard uit.
# Nooit aanzetten met Google of Microsoft zonder OIDC_ALLOWED_GROUPS: dan komt iedereen met zo'n account binnen.
OIDC_AUTO_CREATE=0
# Komma-gescheiden groepen: alleen deze mogen inloggen via SSO, en wie in de beheerdersgroepen zit is beheerder.
OIDC_ALLOWED_GROUPS=
OIDC_ADMIN_GROUPS=
# De claim met de groepen (standaard groups).
OIDC_GROUPS_CLAIM=
# 1 = inloggen met een wachtwoord staat uit. Noodroute: docker compose exec tickory node server/main.ts user signin-code <naam>
OIDC_ONLY=0
# Twee keer per dag kijkt de server bij GitHub of er een nieuwere Tickory is (zonder iets over de server mee te sturen); de
# beheerder en de Android-app zien het dan. 0 = uit, geen enkele verbinding met GitHub.
UPDATE_CHECK=1
# Automatische back-ups (server/autoBackup.ts): de map voor de kopieën, bijvoorbeeld /data/backups. Leeg = uit.
# De server maakt dan elke dag na BACKUP_TIME (HH:MM, in DEFAULT_TIMEZONE) één kopie met de bijlagen, en houdt de nieuwste BACKUP_KEEP.
# Let op de ruimte: elke kopie bevat ook alle bijlagen.
BACKUP_DIR=
BACKUP_TIME=03:00
BACKUP_KEEP=14
# Het sleutelbestand voor tweestapsverificatie (versleutelt de geheimen; maakt de server zelf bij de eerste start). Standaard
# /data/secret.key, naast de database maar bewust niet in een back-up: bewaar er zelf een kopie van, apart van je back-ups.
# Leeg laten = de standaard.
SECRET_KEY_FILE=
