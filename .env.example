# Kopieer dit bestand naar ".env" en vul de gegevens voor het eerste account in.
# Dat account wordt bij de allereerste start aangemaakt en is beheerder: daarmee maak je in de app de andere accounts aan.
# Het wachtwoord heeft minimaal 10 tekens. Na de eerste start kun je het hier weghalen; zet ".env" nooit in git.
TODO_ADMIN_USER=
TODO_ADMIN_PASSWORD=
# De naam zoals anderen die zien (optioneel; anders de gebruikersnaam):
TODO_ADMIN_NAME=
# Staat er een eigen reverse proxy voor (Caddy, nginx, Traefik)? Zet dit dan op 1.
TRUST_PROXY=0
# Meldingen in de browser (herinneringen): jouw contactadres als beheerder, voor de pushdienst van de browser,
# bijvoorbeeld mailto:jij@voorbeeld.nl of een https-adres. Leeg laten mag: dan gaat er geen contactadres mee.
# De pushdienst van Apple (Safari, iPhone, iPad) vraagt er wel om.
VAPID_SUBJECT=
# De tijdzone voor gebruikers die er zelf nog geen hebben ingesteld (de app stelt hem normaal vanzelf in).
DEFAULT_TIMEZONE=Europe/Amsterdam
